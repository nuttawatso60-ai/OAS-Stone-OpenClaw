{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/datasets/schemas/products.schema.json",
  "title": "Product Dataset",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_th", "description_th", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^product_[a-z0-9_]+$" },
          "name_th": { "type": "string", "minLength": 1 },
          "description_th": { "type": "string", "minLength": 1 },
          "materials": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["draft", "approved", "deprecated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
