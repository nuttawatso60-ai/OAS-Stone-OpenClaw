{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/datasets/schemas/quotations.schema.json",
  "title": "Quotation Pattern Dataset",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "product_type", "requirements", "outcome", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^quote_[a-z0-9_]+$" },
          "product_type": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "items": { "type": "string" } },
          "outcome": { "enum": ["quoted", "needs_follow_up", "declined", "unknown"] },
          "price_range_thb": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "status": { "enum": ["draft", "approved", "deprecated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
