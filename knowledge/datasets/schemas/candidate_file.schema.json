{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/datasets/schemas/candidate_file.schema.json",
  "title": "Extraction Candidate File",
  "type": "object",
  "required": ["schema_version", "run_id", "dataset", "candidates"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{16}$"
    },
    "dataset": { "$ref": "#/$defs/dataset" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "dataset",
          "rule_id",
          "rule_version",
          "source_ref",
          "message_indexes",
          "payload"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^cand_[a-f0-9]{24}$"
          },
          "dataset": { "$ref": "#/$defs/dataset" },
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "rule_version": {
            "type": "integer",
            "minimum": 1
          },
          "source_ref": {
            "type": "string",
            "pattern": "^src_[a-f0-9]{16}$"
          },
          "message_indexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "payload": { "$ref": "#/$defs/jsonObject" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dataset": {
      "enum": [
        "intents",
        "faq",
        "objections",
        "quotations",
        "products",
        "vocabulary",
        "conversation_outcomes"
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    }
  }
}
