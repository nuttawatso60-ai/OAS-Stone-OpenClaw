{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/datasets/schemas/response_style_examples.schema.json",
  "title": "Customer Response Style Examples",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "example_type", "evidence", "sanitized_example", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^style_[a-z0-9_]+$" },
          "topic": { "type": "string", "minLength": 1 },
          "example_type": {
            "enum": [
              "question_sequence",
              "price_explanation",
              "negotiation",
              "objection_response",
              "closing",
              "terminology"
            ]
          },
          "evidence": {
            "type": "object",
            "required": ["source_ref", "chunk_id", "message_range"],
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.txt$"
              },
              "chunk_id": { "type": "string", "pattern": "^[^:\u0000-\u001f]+:[0-9]{4}$" },
              "message_range": {
                "type": "object",
                "required": ["start", "end"],
                "properties": {
                  "start": { "type": "integer", "minimum": 0 },
                  "end": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "sanitized_example": { "type": "string", "minLength": 1 },
          "status": { "enum": ["candidate", "reviewed", "approved", "rejected"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
