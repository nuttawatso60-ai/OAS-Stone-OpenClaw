{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/datasets/schemas/chat_index.schema.json",
  "title": "Customer Chat Evidence Index",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_ref",
          "content_sha256",
          "message_range",
          "tags",
          "search_terms",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[^:\u0000-\u001f]+:[0-9]{4}$" },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.txt$"
          },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "message_range": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "search_terms": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "enum": ["indexed", "unparsed"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
